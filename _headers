# Netlify: encabezados de seguridad y caché (se aplican al subir la carpeta)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Imágenes: caché de 7 días (las visitas repetidas de los anuncios cargan al instante)
/assets/*
  Cache-Control: public, max-age=604800

# El HTML y el CSS se revalidan siempre, así los cambios se ven al publicar
/styles.css
  Cache-Control: public, max-age=0, must-revalidate
